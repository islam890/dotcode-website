APP_NAME=DotCode API
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/dotcode
DATABASE_PASSWORD=replace-me
JWT_SECRET_KEY=replace-with-a-generated-random-secret
CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true

# Set APP_ENV=production and replace CORS_ORIGINS with the separately hosted
# frontend origin in the deployment environment. Set API_DOCS_ENABLED=false to
# disable the API schema and documentation endpoints. Never commit production secrets.
